{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/客户端/PerformanceScheduler.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/客户端/src/PerformanceScheduler.App/PerformanceScheduler.App.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/客户端/PerformanceScheduler.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "build-community-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/服务端/src/SuiXinTiao.Community.Api/SuiXinTiao.Community.Api.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "run-community-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/服务端/src/SuiXinTiao.Community.Api/SuiXinTiao.Community.Api.csproj",
        "--launch-profile",
        "SuiXinTiao.Community.Api"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
