<UserControl x:Class="PerformanceScheduler.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui">
    <Grid Margin="20"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <TabControl Style="{StaticResource SegmentedTabControlStyle}">
            <!-- 分段 1: 运行与托盘常驻 -->
            <TabItem Header="{Binding Strings[Segment.TrayAndStartup]}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部两列：启动设置与监控频率 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：托盘与自启设置 -->
                        <Border Grid.Column="0" Margin="0,0,14,0" Padding="18" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.StartupSettings]}" />
                                <DockPanel Margin="0,14,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.LaunchAtStartup]}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="开机启动纯原生 Win32 系统托盘，静默常驻后台" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoStartMonitoringOnLaunch, Mode=TwoWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.AutoStartMonitoringOnLaunch]}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="启动程序后无需手动点击，自动激活前台调度监听" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 右侧：前台扫描轮询频率 -->
                        <Border Grid.Column="1" Padding="18" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.MonitoringInterval]}" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Strings[Hint.MonitoringInterval]}" />
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="焦点应用检测间隔:" />
                                    <ComboBox Grid.Column="1" Height="32" VerticalAlignment="Center" ItemsSource="{Binding MonitoringIntervalOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding MonitoringIntervalSeconds, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 下半部分：存储路径与数据目录 -->
                    <Border Grid.Row="1" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.DataLocations]}" />
                            <Border Grid.Row="1" Margin="0,10,0,0" Padding="12" Background="#FFF9FCFD" BorderBrush="#FFE4EEF7" BorderThickness="1" CornerRadius="12">
                                <TextBlock FontSize="12" FontFamily="Consolas" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding DataLocationSummary}" />
                            </Border>
                            <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.OpenProfilesDirectory]}" Command="{Binding OpenProfilesDirectoryCommand}" Background="#FF1E8FA3" />
                                <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.OpenDeviceStrategiesDirectory]}" Command="{Binding OpenDeviceStrategiesDirectoryCommand}" Background="#FF2E9AAE" />
                                <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.OpenRuntimeDirectory]}" Command="{Binding OpenRuntimeDirectoryCommand}" Background="#FF4E7080" />
                                <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.OpenLogsDirectory]}" Command="{Binding OpenLogsDirectoryCommand}" Background="#FF6A86B7" />
                                <Button Padding="10,6" FontSize="11" Content="{Binding Strings[Button.OpenApplicationDirectory]}" Command="{Binding OpenApplicationDirectoryCommand}" Background="#FF9B6A18" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 分段 2: 安全门禁与自愈 -->
            <TabItem Header="{Binding Strings[Segment.SafetyGates]}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 异常保护三项开关与阈值 -->
                    <Border Grid.Row="0" Margin="0,0,0,16" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FFD64045" Text="{Binding Strings[Section.SafetySettings]}" />
                                <DockPanel Margin="0,12,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding PauseSchedulingAfterUnsafeExit, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.PauseSchedulingAfterUnsafeExit]}" />
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoRollbackOnUnsafeExit, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.AutoRollbackOnUnsafeExit]}" />
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DisableProfileAfterRepeatedUnsafeRuns, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.DisableProfileAfterRepeatedUnsafeRuns]}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.UnsafeRunThreshold]}" />
                                <TextBox Margin="0,8,0,0" Width="120" Height="30" HorizontalAlignment="Left" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" Text="{Binding UnsafeRunThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 下半部分：配置修复与诊断包导出 -->
                    <Border Grid.Row="1" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF9B6A18" Text="配置损坏自愈标记" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Strings[Hint.ResolveConfigurationRecovery]}" />
                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Padding="12,6" FontSize="11" Content="{Binding Strings[Button.ResolveConfigurationRecovery]}" Command="{Binding ResolveConfigurationRecoveryCommand}" Background="#FF9B6A18" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF2E9AAE" Text="排障支持包导出" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="将近期的错误日志、自检结果和脱敏设备指纹一键打包为 ZIP 文件，便于快速诊断。" />
                                <Button Margin="0,12,0,0" HorizontalAlignment="Left" Padding="12,6" FontSize="11" Content="导出诊断支持包 (ZIP)" Command="{Binding ExportDiagnosticPackageCommand}" Background="#FF2E9AAE" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 分段 3: 外观与语言 -->
            <TabItem Header="{Binding Strings[Segment.AppearanceAndLocale]}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 动效设置 -->
                    <Border Grid.Row="0" Margin="0,0,0,16" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.UiMotionSettings]}" />
                                <DockPanel Margin="0,12,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UiMotionEnabled, Mode=TwoWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.UiMotionEnabledTitle]}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Strings[Hint.UiMotionEnabled]}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0" IsEnabled="{Binding UiMotionEnabled}">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UiMotionStaggerEnabled, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Text="{Binding Strings[Hint.UiMotionStagger]}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" IsEnabled="{Binding UiMotionEnabled}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.UiMotionDuration]}" />
                                    <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding UiMotionDurationMilliseconds, StringFormat={}{0:F0} ms}" />
                                </DockPanel>
                                <Slider Margin="0,12,0,0" Minimum="120" Maximum="800" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding UiMotionDurationMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 语言切换与过渡动画 -->
                    <Border Grid.Row="1" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[App.Language]}" />
                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="随芯调支持中英双语界面一键平滑无损热切换。" />
                                <TextBlock Margin="0,12,0,0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding SelectedLanguage.DisplayName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.LanguageAnimationSettings]}" />
                                <DockPanel Margin="0,10,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LanguageTransitionAnimationEnabled, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Text="{Binding Strings[Hint.LanguageTransitionAnimationEnabled]}" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
