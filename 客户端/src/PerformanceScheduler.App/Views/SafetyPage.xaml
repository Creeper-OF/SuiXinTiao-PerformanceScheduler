<UserControl x:Class="PerformanceScheduler.App.Views.SafetyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
    <Grid Margin="28,20,28,24"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Nav.SafetyTitle]}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="安全规则为最终硬约束 · 区分暂停与回滚 · 原子自愈基线校验" />
        </StackPanel>

        <!-- 顶部操作卡片: 暂停调度 vs 一键紧急回滚 -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="调度控制与紧急恢复" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="暂停仅停止后续自动调控；回滚将立即通过原子事务撤销所有改动并复原系统初始基线。" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,12,0" Padding="18,10" Background="#FFEAF2FF" Foreground="{StaticResource AccentBrush}" BorderThickness="0"
                            Content="暂停/恢复调度" Command="{Binding ToggleMonitoringCommand}" />
                    <Button Padding="18,10" Background="#FFFFF2F4" Foreground="#FFD64045" BorderBrush="#FFFFD0D6" BorderThickness="1"
                            Content="一键紧急回滚 ↶" Command="{Binding RestoreCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 中部两列: 安全门禁与硬件自检报告 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <!-- 左列: 安全门控配置 -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="异常自愈与安全保护门限" />
                    <DockPanel Margin="0,16,0,0">
                        <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding PauseSchedulingAfterUnsafeExit, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.PauseSchedulingAfterUnsafeExit]}" />
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoRollbackOnUnsafeExit, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.AutoRollbackOnUnsafeExit]}" />
                    </DockPanel>
                    <DockPanel Margin="0,14,0,0">
                        <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DisableProfileAfterRepeatedUnsafeRuns, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.DisableProfileAfterRepeatedUnsafeRuns]}" />
                    </DockPanel>
                    <StackPanel Margin="0,18,0,0">
                        <Button HorizontalAlignment="Left" Padding="14,8" Content="导出诊断支持包 (ZIP)" Command="{Binding ExportDiagnosticPackageCommand}" Background="#FF2E9AAE" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 右列: 自检与恢复审计 -->
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Padding="12,6" FontSize="11" Content="运行全量自检" Command="{Binding RunFullSelfTestCommand}" Background="#FF228670" />
                        <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="硬件能力与自检核验报告" />
                    </DockPanel>
                    <ListBox Grid.Row="1" Margin="0,14,0,0" Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding SelfTestResultLines}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,6" Background="#FFF9FCFD" BorderBrush="#FFE4EEF7" BorderThickness="1" CornerRadius="8">
                                    <TextBlock FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TitleBrush}" Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
