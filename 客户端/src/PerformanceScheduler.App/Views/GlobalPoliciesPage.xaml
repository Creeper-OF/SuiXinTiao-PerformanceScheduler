<UserControl x:Class="PerformanceScheduler.App.Views.GlobalPoliciesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
    <Grid Margin="28,20,28,24"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题与原型说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Nav.GlobalPoliciesTitle]}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="全局默认基准 · 顶栏资源域切换 · AC / DC 分别独立实时编辑保存" />
        </StackPanel>

        <!-- 顶栏资源域分段胶囊: 电源管理 | 性能调节 | 后台管理 -->
        <Border Grid.Row="1" Margin="0,0,0,16" HorizontalAlignment="Left" Padding="4" Background="#FFE8EEF5" BorderBrush="#FFDCE5F0" BorderThickness="1" CornerRadius="12">
            <StackPanel Orientation="Horizontal">
                <Button Padding="16,8" Background="Transparent" BorderThickness="0" Command="{Binding SelectGlobalPolicyDomainCommand}" CommandParameter="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="10">
                                            <TextBlock x:Name="TabLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="电源管理" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsGlobalPowerDomainSelected}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFFFF" />
                                                <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="4,0,0,0" Padding="16,8" Background="Transparent" BorderThickness="0" Command="{Binding SelectGlobalPolicyDomainCommand}" CommandParameter="1">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="10">
                                            <TextBlock x:Name="TabLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="性能调节" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsGlobalPerformanceDomainSelected}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFFFF" />
                                                <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Margin="4,0,0,0" Padding="16,8" Background="Transparent" BorderThickness="0" Command="{Binding SelectGlobalPolicyDomainCommand}" CommandParameter="2">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="10">
                                            <TextBlock x:Name="TabLabel" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="后台管理" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsGlobalBackgroundDomainSelected}" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFFFF" />
                                                <Setter TargetName="TabLabel" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- 编辑对象卡片 -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="24,18" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="编辑对象：全局默认策略" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="按供电条件分别保存，修改插电 AC 或离电 DC 互不干扰。" />
            </StackPanel>
        </Border>

        <!-- 中间两张卡片: 插电 AC vs 离电 DC (参数面板) -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左卡片: 插电 AC -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,14" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="插电 AC 全局参数" />

                    <!-- 域 0: 电源管理 -->
                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGlobalPowerDomainSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="Windows 电源计划:" />
                        <ComboBox Margin="0,6,0,14" Height="32" ItemsSource="{Binding PowerPlanOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding GlobalAcPowerPlan, Mode=TwoWay}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="处理器最大状态 (%):" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center" Minimum="10" Maximum="100" SmallChange="1" LargeChange="5" Value="{Binding GlobalAcProcessorMaxStatePercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding GlobalAcProcessorMaxStatePercent, StringFormat='{}{0}%'}" />
                        </Grid>
                    </StackPanel>

                    <!-- 域 1: 性能调节 (GPU & 进程优先级) -->
                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGlobalPerformanceDomainSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="前台应用基准调度优先级:" />
                        <ComboBox Margin="0,6,0,14" Height="32" ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding GlobalAcPriority, Mode=TwoWay}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="GPU 控制模式:" />
                        <ComboBox Margin="0,6,0,0" Height="32" ItemsSource="{Binding GpuModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding GlobalAcGpuMode, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 域 2: 后台管理 -->
                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGlobalBackgroundDomainSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel Margin="0,4,0,0">
                            <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding GlobalAcLowerBackground, Mode=TwoWay}" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="自动压制非活跃后台进程" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="前台激活时自动降低后台抢占资源" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右卡片: 离电 DC -->
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,14" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="离电 DC 全局参数" />

                    <!-- 域 0: 电源管理 -->
                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGlobalPowerDomainSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="Windows 电源计划:" />
                        <ComboBox Margin="0,6,0,14" Height="32" ItemsSource="{Binding PowerPlanOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding GlobalDcPowerPlan, Mode=TwoWay}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="处理器最大状态 (%):" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Slider VerticalAlignment="Center" Minimum="10" Maximum="100" SmallChange="1" LargeChange="5" Value="{Binding GlobalDcProcessorMaxStatePercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding GlobalDcProcessorMaxStatePercent, StringFormat='{}{0}%'}" />
                        </Grid>
                    </StackPanel>

                    <!-- 域 1: 性能调节 (GPU & 进程优先级) -->
                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGlobalPerformanceDomainSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="前台应用基准调度优先级:" />
                        <ComboBox Margin="0,6,0,14" Height="32" ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding GlobalDcPriority, Mode=TwoWay}" />
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="GPU 控制模式:" />
                        <ComboBox Margin="0,6,0,0" Height="32" ItemsSource="{Binding GpuModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding GlobalDcGpuMode, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 域 2: 后台管理 -->
                    <StackPanel Grid.Row="1">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGlobalBackgroundDomainSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel Margin="0,4,0,0">
                            <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding GlobalDcLowerBackground, Mode=TwoWay}" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="自动压制非活跃后台进程" />
                                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="离电状态更优先节省整机功耗" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作栏: 保存更改 · 预览差异 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Padding="18,10" Content="保存全局策略" Command="{Binding SaveGlobalPoliciesCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
