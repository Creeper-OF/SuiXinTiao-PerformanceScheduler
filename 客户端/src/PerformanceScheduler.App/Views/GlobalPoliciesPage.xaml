<UserControl x:Class="PerformanceScheduler.App.Views.GlobalPoliciesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
    <Grid Margin="28,20,28,24"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题与原型说明 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Nav.GlobalPoliciesTitle]}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="全局默认基准 · 顶栏资源域切换 · AC / DC 分别独立保存" />
        </StackPanel>

        <!-- 顶栏资源域分段胶囊: 电源管理 | 性能调节 | 后台管理 -->
        <Border Grid.Row="1" Margin="0,0,0,16" HorizontalAlignment="Left" Padding="4" Background="#FFE8EEF5" BorderBrush="#FFDCE5F0" BorderThickness="1" CornerRadius="12">
            <StackPanel Orientation="Horizontal">
                <Border Padding="16,8" Background="#FFFFFFFF" CornerRadius="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="电源管理" />
                </Border>
                <Border Margin="4,0,0,0" Padding="16,8" Background="Transparent" CornerRadius="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="性能调节" />
                </Border>
                <Border Margin="4,0,0,0" Padding="16,8" Background="Transparent" CornerRadius="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="后台管理" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 编辑对象卡片 -->
        <Border Grid.Row="2" Margin="0,0,0,16" Padding="24,18" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="编辑对象：全局默认策略" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="按供电条件分别保存，不影响另一供电状态。" />
            </StackPanel>
        </Border>

        <!-- 中间两张卡片: 插电 AC vs 离电 DC -->
        <Grid Grid.Row="3" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左卡片: 插电 AC -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="插电 AC" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource SidebarMutedBrush}" Text="Windows 电源方案：高性能" />
                    <TextBlock Grid.Row="2" Margin="0,24,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="处理器最大状态：100%" />
                    <TextBlock Grid.Row="3" Margin="0,18,0,0" FontSize="14" Foreground="{StaticResource TitleBrush}" Text="GPU 限制：按配置执行 (全速释放)" />
                </Grid>
            </Border>

            <!-- 右卡片: 离电 DC -->
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="离电 DC" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource SidebarMutedBrush}" Text="Windows 电源方案：平衡" />
                    <TextBlock Grid.Row="2" Margin="0,24,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="处理器最大状态：70%" />
                    <TextBlock Grid.Row="3" Margin="0,18,0,0" FontSize="14" Foreground="{StaticResource TitleBrush}" Text="GPU 限制：保守模式 (节能降频)" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部操作栏: 保存更改 · 预览差异 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Padding="18,10" Content="保存更改" Command="{Binding SaveProfileCommand}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Cursor="Hand" Text="预览差异" />
        </StackPanel>
    </Grid>
</UserControl>
