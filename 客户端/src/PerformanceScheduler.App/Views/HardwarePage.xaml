<UserControl x:Class="PerformanceScheduler.App.Views.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
    <Grid Margin="20"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <TabControl Style="{StaticResource SegmentedTabControlStyle}">
            <!-- 分段 1: GPU 驱动直锁 -->
            <TabItem Header="{Binding Strings[Segment.GpuDirect]}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部两列：核心频率与电压偏置 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左列：GPU 核心锁频配置 -->
                        <Border Grid.Column="0" Margin="0,0,14,0" Padding="18" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF4E65A8" Text="GPU 核心时钟锁频" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="通过底层原生驱动接口 (NVML / ADLX / OneAPI) 直接限制 GPU 核心最高频率与电压。" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="GPU 核心最高频率 (MHz):" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}" Text="留空表示不限制，交由 GPU 驱动自适应" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" Text="{Binding ProfileDraft.GpuMaxCoreClockMHzText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="GPU 核心电压偏置 (mV):" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}" Text="支持降压或微调电压以优化能耗比" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Height="32" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" Text="{Binding ProfileDraft.GpuVoltageOffsetMvText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 右列：调控模式与高级扩展 -->
                        <Border Grid.Column="1" Padding="18" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="调控模式与扩展权限" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="160" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="显卡偏好模式:" />
                                    <ComboBox Grid.Column="1" Height="32" VerticalAlignment="Center" ItemsSource="{Binding GpuModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.GpuMode, Mode=TwoWay}" />
                                </Grid>
                                <DockPanel Margin="0,16,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ProfileDraft.GpuAllowVendorApi, Mode=TwoWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="允许调用厂商扩展驱动 API" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}" Text="启用 NVML 深度时钟锁定。若驱动崩溃系统将自动降级并秒级复位。" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 下方：GPU 适配器摘要与自愈状态 -->
                    <Border Grid.Row="1" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding GpuAdapterSummary}" />
                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding GpuControlReadinessSummary}" />
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Padding="12,6" FontSize="11" Content="紧急复位 GPU 时钟" Command="{Binding RestoreCommand}" Background="#FFFFF2F4" Foreground="#FFD64045" BorderBrush="#FFFFD0D6" BorderThickness="1" />
                            </DockPanel>
                            <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="#FFF5FAFF" BorderBrush="#FFDCE6F5" BorderThickness="1" CornerRadius="12">
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding GpuCapabilitySummary}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 分段 2: CPU 核心调度与软硬绑核 -->
            <TabItem Header="{Binding Strings[Segment.CpuScheduling]}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 上半部分：CPU 硬亲和性 vs CPU Sets 软调度集 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：CPU 硬亲和性 (Affinity Mask) -->
                        <Border Grid.Column="0" Margin="0,0,14,0" Padding="18" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageEyebrowStyle}" Foreground="#FF1F7A5C" Text="CPU 硬亲和性 (Affinity Mask)" />
                                    <primitives:ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ProfileDraft.CpuAffinityEnabled, Mode=TwoWay}" />
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="使用 Win32 原生掩码直接锁定线程运行的物理/逻辑核心。" />
                                <Grid Margin="0,12,0,0" IsEnabled="{Binding ProfileDraft.CpuAffinityEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="前台亲和性掩码 (十六进制):" />
                                    <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Consolas" Text="{Binding ProfileDraft.ForegroundAffinityMaskText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,10,0,0" IsEnabled="{Binding ProfileDraft.CpuAffinityEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="后台亲和性掩码 (十六进制):" />
                                    <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Consolas" Text="{Binding ProfileDraft.BackgroundAffinityMaskText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 右侧：CPU Sets 调度集 (软亲和性) -->
                        <Border Grid.Column="1" Padding="18" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageEyebrowStyle}" Foreground="#FF9B6A18" Text="CPU Sets 调度集 (Windows 10/11 软亲和性)" />
                                    <primitives:ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ProfileDraft.CpuSetsEnabled, Mode=TwoWay}" />
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="采用 Win10 14393+ 现代 CPU Sets，为前后台指定首选核心 ID，内核调度器软性倾斜且不造成硬死锁。" />
                                <Grid Margin="0,12,0,0" IsEnabled="{Binding ProfileDraft.CpuSetsEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="前台核心集合 (如 0,1,2,3):" />
                                    <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Consolas" Text="{Binding ProfileDraft.ForegroundCpuSetsText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="0,10,0,0" IsEnabled="{Binding ProfileDraft.CpuSetsEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="后台核心集合 (如 4,5,6,7):" />
                                    <TextBox Grid.Column="1" Height="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontFamily="Consolas" Text="{Binding ProfileDraft.BackgroundCpuSetsText, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 下半部分：能效核优先偏好与调度仲裁 -->
                    <Border Grid.Row="1" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="异构大小核感知" />
                                <DockPanel Margin="0,10,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ProfileDraft.PreferEfficiencyModeForBackground, Mode=TwoWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="后台进程能效核 (E-Core) 优先调度" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}" Text="自动将非前台活跃应用压制至能效小核，为主游戏或工作站应用独占性能大核 (P-Core)。" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="资源冲突仲裁" />
                                <DockPanel Margin="0,10,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ProfileDraft.UseResourceArbitration, Mode=TwoWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="启用动态资源冲突仲裁引擎" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}" Text="当后台出现突发高负载时，动态介入压制其 CPU 配额，避免前台丢帧卡顿。" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 分段 3: 后台进程硬限制与优先级 -->
            <TabItem Header="{Binding Strings[Segment.JobAndLimits]}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 上半部分：I/O 优先级与内存优先级 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：I/O 优先级调控 -->
                        <Border Grid.Column="0" Margin="0,0,14,0" Padding="18" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageEyebrowStyle}" Foreground="#FF2E9AAE" Text="进程 I/O 调度优先级" />
                                    <primitives:ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ProfileDraft.MemoryIoPriorityEnabled, Mode=TwoWay}" />
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="调控磁盘读写调度优先级 (NtSetInformationProcess)，防止后台磁盘写入抢占前台加载资源。" />
                                <Grid Margin="0,12,0,0" IsEnabled="{Binding ProfileDraft.MemoryIoPriorityEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="前台 I/O 优先级:" />
                                    <ComboBox Grid.Column="1" Height="30" VerticalAlignment="Center" ItemsSource="{Binding IoPriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.ForegroundIoPriority, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,10,0,0" IsEnabled="{Binding ProfileDraft.MemoryIoPriorityEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="后台 I/O 优先级:" />
                                    <ComboBox Grid.Column="1" Height="30" VerticalAlignment="Center" ItemsSource="{Binding IoPriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.BackgroundIoPriority, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 右侧：内存分页优先级调控 -->
                        <Border Grid.Column="1" Padding="18" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF8A3B49" Text="内存分页优先级 (Memory Priority)" />
                                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="控制 Windows 内存管理器的物理内存回收与换页顺序，后台应用设置 VeryLow 可优先释放物理内存。" />
                                <Grid Margin="0,12,0,0" IsEnabled="{Binding ProfileDraft.MemoryIoPriorityEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="前台内存优先级:" />
                                    <ComboBox Grid.Column="1" Height="30" VerticalAlignment="Center" ItemsSource="{Binding MemoryPriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.ForegroundMemoryPriority, Mode=TwoWay}" />
                                </Grid>
                                <Grid Margin="0,10,0,0" IsEnabled="{Binding ProfileDraft.MemoryIoPriorityEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="后台内存优先级:" />
                                    <ComboBox Grid.Column="1" Height="30" VerticalAlignment="Center" ItemsSource="{Binding MemoryPriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.BackgroundMemoryPriority, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 下半部分：进程优先级基线与回滚控制 -->
                    <Border Grid.Row="1" Padding="18" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：基础进程优先级 -->
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="前后台基准 CPU 优先级" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="前台进程优先级:" />
                                    <ComboBox Grid.Column="1" Height="30" VerticalAlignment="Center" ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.ForegroundPriority, Mode=TwoWay}" />
                                </Grid>
                                <DockPanel Margin="0,12,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ProfileDraft.LowerBackgroundProcesses, Mode=TwoWay}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="自动降低所有被抢占至后台的进程优先级" />
                                </DockPanel>
                            </StackPanel>

                            <!-- 右侧：退出时安全还原原值 -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF1F6F5E" Text="生命周期还原防护" />
                                <DockPanel Margin="0,10,0,0">
                                    <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding ProfileDraft.RestoreOnExit, Mode=TwoWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="应用退出或失去焦点时恢复原值" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource SidebarMutedBrush}" Text="写前基线保存，应用切出或关闭时精准恢复，绝不残留脏配置。" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
