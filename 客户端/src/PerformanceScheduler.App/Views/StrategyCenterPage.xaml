<UserControl x:Class="PerformanceScheduler.App.Views.StrategyCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PerformanceScheduler.Core.Models;assembly=PerformanceScheduler.Core"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
<ScrollViewer VerticalScrollBarVisibility="Auto">
 <Grid Margin="28"
       ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
       ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CardStyle}" Padding="22" Background="#FFF9FCFD">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.ProfileLibrary]}"/>
     <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" TextTrimming="CharacterEllipsis" Text="{Binding ProfileEditorStatus}"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,16,0,0">
     <Button Content="{Binding Strings[Button.Reload]}" Command="{Binding ReloadProfilesCommand}" Background="#FF315F72"/>
     <Button Content="{Binding Strings[Button.New]}" Command="{Binding NewProfileCommand}" Background="#FF1F7A5C"/>
     <Button Content="{Binding Strings[Button.Save]}" Command="{Binding SaveProfileCommand}"/>
     <Button Content="{Binding Strings[Button.Import]}" Command="{Binding ImportProfilesCommand}" Background="#FF6178A6"/>
     <Button Content="{Binding Strings[Button.Export]}" Command="{Binding ExportProfilesCommand}" Background="#FF946C2B"/>
     <Button Content="{Binding Strings[Button.ImportMigration]}" Command="{Binding ImportMigrationPackageCommand}" Background="#FF5B86A8"/>
     <Button Content="{Binding Strings[Button.ExportMigration]}" Command="{Binding ExportMigrationPackageCommand}" Background="#FF2E9AAE"/>
     <Button Content="{Binding Strings[Button.RollbackRevision]}" Command="{Binding RollbackProfileCommand}" Background="#FF8A3B49"/>
    </WrapPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="#FFFDFBF5">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0">
    <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF9B6A18" Text="{Binding Strings[Section.OperationPath]}"/>
     <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.ProfilePathCommunityTitle]}"/>
     <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.ProfilePathCommunityBody]}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="12,0,12,0">
     <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.LocalDeviceStrategies]}"/>
     <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.ProfilePathLocalTitle]}"/>
     <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.ProfilePathLocalBody]}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Margin="12,0,0,0">
     <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF2F7B5A" Text="{Binding Strings[Section.SavedProfiles]}"/>
     <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.ProfilePathEditTitle]}"/>
     <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.ProfilePathEditBody]}"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" Margin="0,0,0,20" Style="{StaticResource CardStyle}" Background="#FFF6FBFD">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.CommunityHub]}"/>
      <TextBlock Style="{StaticResource PageTitleStyle}" Margin="0,6,0,0" FontSize="20" Text="{Binding Strings[Section.Community]}"/>
      <TextBlock Style="{StaticResource PageDescriptionStyle}" Margin="0,6,0,0" MaxHeight="36" Text="{Binding Strings[Hint.CommunityHub]}"/>
      <TextBlock Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding CommunityCatalogStatus}"/>
      <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding CommunityFilterSummary}"/>
      <WrapPanel Margin="0,12,0,0">
       <Border Padding="10,4" Margin="0,0,8,0" Background="#FFE7F4F6" CornerRadius="999"><TextBlock Text="{Binding Strings[Community.FilterPluggedIn]}"/></Border>
       <Border Padding="10,4" Background="#FFFFF3E5" CornerRadius="999"><TextBlock Text="{Binding Strings[Community.FilterBattery]}"/></Border>
      </WrapPanel>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
      <Button Content="{Binding Strings[Button.RefreshCommunity]}" Command="{Binding RefreshCommunityCatalogCommand}" Background="#FF6178A6"/>
      <Button Content="{Binding Strings[Button.ImportDeviceStrategy]}" Command="{Binding ImportCommunityDeviceStrategyCommand}" Visibility="{Binding CommunityDeviceStrategiesVisibility}" Background="#FF315F72"/>
      <Button Content="{Binding Strings[Button.ImportCommunity]}" Command="{Binding ImportCommunityProfileCommand}" Visibility="{Binding CommunityProfilesVisibility}" Background="#FF315F72"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="0,18,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.Search]}"/><TextBox Text="{Binding CommunitySearchText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.SourceFilter]}"/><ComboBox ItemsSource="{Binding CommunitySourceFilterOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SelectedCommunitySourceFilter, Mode=TwoWay}"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="10,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.PowerSourceMode]}"/><ComboBox ItemsSource="{Binding CommunityPowerFilterOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SelectedCommunityPowerFilter, Mode=TwoWay}"/></StackPanel>
     <StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.TargetClassification]}"/><ComboBox ItemsSource="{Binding CommunityClassificationFilterOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding SelectedCommunityClassificationFilter, Mode=TwoWay}"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,18,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Height="44" Padding="4" Background="#FFE8F4F7" BorderBrush="#FFD1E4EA" BorderThickness="1" CornerRadius="22">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button Grid.Column="0" Content="{Binding Strings[Section.DeviceStrategies]}" Command="{Binding SelectCommunitySectionCommand}" CommandParameter="DeviceStrategies" Margin="0" Padding="14,8">
        <Button.Style>
         <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{StaticResource TitleBrush}"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsCommunityDeviceStrategiesSelected}" Value="True">
            <Setter Property="Background" Value="#FF1E8FA3"/>
            <Setter Property="Foreground" Value="White"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Button.Style>
       </Button>
       <Button Grid.Column="1" Content="{Binding Strings[Section.StandaloneProfiles]}" Command="{Binding SelectCommunitySectionCommand}" CommandParameter="Profiles" Margin="0" Padding="14,8">
        <Button.Style>
         <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{StaticResource TitleBrush}"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding IsCommunityProfilesSelected}" Value="True">
            <Setter Property="Background" Value="#FF1E8FA3"/>
            <Setter Property="Foreground" Value="White"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </Button.Style>
       </Button>
      </Grid>
     </Border>
    <ListBox Grid.Row="1" Margin="0,14,0,0" Height="190" Visibility="{Binding CommunityDeviceStrategiesVisibility}" ItemsSource="{Binding CommunityDeviceStrategies}" SelectedItem="{Binding SelectedCommunityDeviceStrategy, Mode=TwoWay}">
      <ListBox.ItemTemplate>
       <DataTemplate DataType="{x:Type viewModels:CommunityDeviceStrategyListItemViewModel}">
        <Border Margin="0,0,0,10" Padding="14" Background="White" BorderBrush="#FFE2E8EC" BorderThickness="1" CornerRadius="14">
         <StackPanel>
          <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Name}"/>
          <TextBlock Margin="0,6,0,0" FontSize="12" Text="{Binding Summary}"/>
          <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}"/>
          <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding Meta}"/>
         </StackPanel>
        </Border>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    <ListBox Grid.Row="1" Margin="0,14,0,0" Height="190" Visibility="{Binding CommunityProfilesVisibility}" ItemsSource="{Binding CommunityProfiles}" SelectedItem="{Binding SelectedCommunityProfile, Mode=TwoWay}">
     <ListBox.ItemTemplate>
      <DataTemplate DataType="{x:Type viewModels:CommunityProfileListItemViewModel}">
       <Border Margin="0,0,0,10" Padding="14" Background="White" BorderBrush="#FFE2E8EC" BorderThickness="1" CornerRadius="14">
        <StackPanel>
         <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Name}"/>
         <TextBlock Margin="0,6,0,0" FontSize="12" Text="{Binding Summary}"/>
         <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Description}"/>
         <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding Meta}"/>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    </Grid>
   </Grid>
  </Border>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="1.38*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource CardStyle}" Background="#FFF7FAFB">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.LocalDeviceStrategies]}"/>
     <ListBox Grid.Row="1" Margin="0,12,0,10" Height="130" ItemsSource="{Binding DeviceStrategyPackages}" SelectedItem="{Binding SelectedDeviceStrategyPackage, Mode=TwoWay}">
       <ListBox.ItemTemplate><DataTemplate DataType="{x:Type viewModels:DeviceStrategyPackageListItemViewModel}"><Border Margin="0,0,0,10" Padding="14" Background="White" BorderBrush="#FFD6E8EF" BorderThickness="1" CornerRadius="14"><StackPanel><TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Name}"/><TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Summary}"/><TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding Meta}"/><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding EnabledText}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
      <WrapPanel Grid.Row="2" Margin="0,0,0,12"><Button Margin="0,0,8,8" Content="{Binding Strings[Button.CreateDeviceStrategy]}" Command="{Binding CreateDeviceStrategyPackageCommand}"/><Button Margin="0,0,8,8" Content="{Binding Strings[Button.ToggleDeviceStrategy]}" Command="{Binding ToggleDeviceStrategyPackageCommand}"/><Button Margin="0,0,0,8" Content="{Binding Strings[Button.AddProfileToDeviceStrategy]}" Command="{Binding AddProfileToDeviceStrategyCommand}" Background="#FF1F7A5C"/></WrapPanel>
     <TextBlock Grid.Row="3" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.DeviceStrategyContents]}"/>
     <ListBox Grid.Row="4" Margin="0,10,0,8" Height="120" ItemsSource="{Binding SelectedDeviceStrategyProfiles}" SelectedItem="{Binding SelectedDeviceStrategyProfile, Mode=TwoWay}">
      <ListBox.ItemTemplate><DataTemplate DataType="{x:Type viewModels:DeviceStrategyProfileItemViewModel}"><Border Margin="0,0,0,8" Padding="10" Background="White" BorderBrush="#FFE2E8EC" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Name}"/><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}" Text="{Binding Meta}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button Grid.Row="5" Margin="0,0,0,14" HorizontalAlignment="Left" Content="{Binding Strings[Button.RemoveProfileFromDeviceStrategy]}" Command="{Binding RemoveProfileFromDeviceStrategyCommand}" Background="#FF8A3B49"/>
     <TextBlock Grid.Row="6" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.SavedProfiles]}"/>
     <ListBox Grid.Row="7" Margin="0,12,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
      <ListBox.ItemTemplate><DataTemplate DataType="{x:Type viewModels:ProfileListItemViewModel}"><Border Margin="0,0,0,10" Padding="14" Background="White" BorderBrush="#FFE2E8EC" BorderThickness="1" CornerRadius="14"><StackPanel><TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Name}"/><TextBlock Margin="0,6,0,0" FontSize="12" Text="{Binding Summary}"/><TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding EnabledText}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource CardStyle}" Background="#FFFCFDFC"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.ProfileName]}"/><TextBox Text="{Binding ProfileDraft.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.Version]}"/><TextBox Text="{Binding ProfileDraft.Version, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel>
    </Grid>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,10,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.TargetClassification]}"/><ComboBox ItemsSource="{Binding ClassificationOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.TargetClassification, Mode=TwoWay, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.ForegroundPriority]}"/><ComboBox ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.ForegroundPriority, Mode=TwoWay}"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="10,0,10,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.PowerSourceMode]}"/><ComboBox ItemsSource="{Binding PowerSourceOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.PowerSourceMode, Mode=TwoWay}"/></StackPanel>
     <StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.PowerPlanSelection]}"/><ComboBox ItemsSource="{Binding PowerPlanOptions}" SelectedItem="{Binding ProfileDraft.SelectedPowerPlan, Mode=TwoWay}" DisplayMemberPath="DisplayName"/></StackPanel>
    </Grid>
    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
     <CheckBox Content="{Binding Strings[Common.Enabled]}" IsChecked="{Binding ProfileDraft.IsEnabled, Mode=TwoWay}"/>
     <CheckBox Margin="20,10,0,0" Content="{Binding Strings[Hint.RestorePowerPlan]}" IsChecked="{Binding ProfileDraft.RestoreOnExit, Mode=TwoWay}"/>
     <CheckBox Margin="20,10,0,0" Content="{Binding Strings[Hint.GlobalDefaultProfile]}" IsChecked="{Binding ProfileDraft.IsGlobalDefault, Mode=TwoWay}"/>
    </StackPanel>
    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
     <CheckBox Content="{Binding Strings[Hint.LowerBackgroundProcesses]}" IsChecked="{Binding ProfileDraft.LowerBackgroundProcesses, Mode=TwoWay}"/>
     <StackPanel IsEnabled="{Binding SupportsEfficiencyModeHint}" ToolTipService.ShowOnDisabled="True">
      <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding SupportsEfficiencyModeHint}" Value="False"><Setter Property="ToolTip" Value="{Binding Strings[Capability.EfficiencyUnsupported]}"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <CheckBox Margin="20,10,0,0" Content="{Binding Strings[Hint.PreferEfficiencyModeForBackground]}" IsChecked="{Binding ProfileDraft.PreferEfficiencyModeForBackground, Mode=TwoWay}" IsEnabled="{Binding ProfileDraft.LowerBackgroundProcesses}"/>
     </StackPanel>
    </StackPanel>
    <Border Margin="0,14,0,0" Padding="12" Background="#FFF8FCFD" CornerRadius="14">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FFDCE8EE"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding ProfileDraft.HasPowerPlanIssues}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ValidationBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="1.28*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.ProcessorMaxState]}"/><TextBox Text="{Binding ProfileDraft.ProcessorMaxStatePercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
      <TextBlock Grid.Column="1" Margin="10,3,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.ProcessorMaxState]}"/>
     </Grid>
    </Border>
    <Border Margin="0,14,0,0" Padding="12" Background="#FFFDFEFE" BorderBrush="#FFE0E8EC" BorderThickness="1" CornerRadius="14">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FFE0E8EC"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding ProfileDraft.HasMatchRuleIssues}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ValidationBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.ExecutableNames]}"/><TextBlock FontSize="12" Text="{Binding Strings[Hint.ExecutableNames]}"/><TextBox Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding ProfileDraft.ExecutableNamesText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.ProcessNames]}"/><TextBlock FontSize="12" Text="{Binding Strings[Hint.ProcessNames]}"/><TextBox Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding ProfileDraft.ProcessNamesText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.WindowTitleContains]}"/><TextBlock FontSize="12" Text="{Binding Strings[Hint.WindowTitleContains]}"/><TextBox Height="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding ProfileDraft.WindowTitleContainsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
     </Grid>
    </Border>
    <Border Margin="0,14,0,0" Padding="14" Background="#FFF7FBFF" BorderBrush="#FFD8E8F8" BorderThickness="1" CornerRadius="14">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FFD8E8F8"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding ProfileDraft.HasTargetExperienceIssues}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ValidationBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.TargetExperience]}"/><CheckBox Margin="18,0,0,0" Content="{Binding Strings[Common.Enabled]}" IsChecked="{Binding ProfileDraft.TargetExperienceEnabled, Mode=TwoWay}"/></StackPanel>
      <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.TargetExperience]}"/>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.TargetFramesPerSecond]}"/><TextBox Text="{Binding ProfileDraft.TargetFramesPerSecondText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.TargetFrameTimeP95]}"/><TextBox Text="{Binding ProfileDraft.TargetFrameTimeP95MillisecondsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="10,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.TargetTemperatureLimit]}"/><TextBox Text="{Binding ProfileDraft.TargetTemperatureCelsiusText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.TargetPowerLimit]}"/><TextBox Text="{Binding ProfileDraft.TargetPowerWattsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
      </Grid>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.ExperiencePriority]}"/><ComboBox ItemsSource="{Binding TargetExperiencePriorityOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.TargetExperiencePriority, Mode=TwoWay}"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.ExperienceControlMode]}"/><ComboBox ItemsSource="{Binding TargetExperienceControlModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.TargetExperienceControlMode, Mode=TwoWay}"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="10,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.NoisePreference]}"/><ComboBox ItemsSource="{Binding TargetNoisePreferenceOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.TargetNoisePreference, Mode=TwoWay}"/></StackPanel>
       <StackPanel Grid.Column="3" Margin="10,0,0,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.ObservationWindow]}"/><TextBox Text="{Binding ProfileDraft.TargetObservationWindowSecondsText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
      </Grid>
      <Grid Margin="0,12,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="0.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.Hysteresis]}"/><TextBox Text="{Binding ProfileDraft.TargetHysteresisPercentText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
       <TextBlock Grid.Column="1" Margin="10,3,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.TargetExperienceReadOnly]}"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border Margin="0,14,0,0" Padding="14" Background="#FFF7FAFB" BorderBrush="#FFE0E8EC" BorderThickness="1" CornerRadius="14">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FFE0E8EC"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding ProfileDraft.HasBackgroundPolicyIssues}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ValidationBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.BackgroundPolicies]}"/><TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding Strings[Hint.BackgroundPolicies]}"/></StackPanel><Button Grid.Column="1" Content="{Binding Strings[Button.AddPolicy]}" Command="{Binding AddBackgroundPolicyCommand}" Background="#FF1F7A5C"/></Grid>
      <ItemsControl Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding ProfileDraft.BackgroundPolicies}">
       <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type viewModels:BackgroundPolicyDraftItemViewModel}">
         <Border Margin="0,0,0,10" Padding="12" Background="White" BorderBrush="#FFE2E8EC" BorderThickness="1" CornerRadius="12">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <StackPanel Margin="0,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Strings[Section.Category], RelativeSource={RelativeSource AncestorType=Window}}"/><ComboBox ItemsSource="{Binding DataContext.BackgroundPolicyCategoryOptions, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
           <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Strings[Section.TargetPriority], RelativeSource={RelativeSource AncestorType=Window}}"/><ComboBox ItemsSource="{Binding DataContext.PriorityOptions, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding TargetPriority, Mode=TwoWay}"/></StackPanel>
           <Button Grid.Column="2" VerticalAlignment="Bottom" Content="{Binding DataContext.Strings[Button.Remove], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding DataContext.RemoveBackgroundPolicyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#FF8A3B49"/>
           <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0"><CheckBox Content="{Binding DataContext.Strings[Hint.PreferEfficiencyMode], RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding PreferEfficiencyMode, Mode=TwoWay}" ToolTipService.ShowOnDisabled="True"><CheckBox.Style><Style TargetType="CheckBox"><Style.Triggers><DataTrigger Binding="{Binding DataContext.SupportsEfficiencyModeHint, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="IsEnabled" Value="False"/><Setter Property="ToolTip" Value="{Binding DataContext.Strings[Capability.EfficiencyUnsupported], RelativeSource={RelativeSource AncestorType=Window}}"/></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox><TextBlock Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding DataContext.Strings[Section.Notes], RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox MinHeight="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </Grid>
    </Border>
    <Border Margin="0,14,0,0" Padding="14" Background="#FFF6F8FD" BorderBrush="#FFDCE3F2" BorderThickness="1" CornerRadius="14">
     <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#FFDCE3F2"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding ProfileDraft.HasGpuIssues}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ValidationBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel>
      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.GpuStrategy]}"/>
      <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.GpuStrategy]}"/>
      <Border Margin="0,12,0,0" Padding="12" Background="#FFFFFFFF" BorderBrush="#FFE1E6F0" BorderThickness="1" CornerRadius="12">
       <StackPanel>
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF4E65A8" Text="{Binding GpuAdapterSummary}"/>
       <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding GpuCapabilitySummary}"/>
       <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding GpuControlReadinessSummary}"/>
       </StackPanel>
      </Border>
      <Grid Margin="0,14,0,0" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.GpuMode]}"/><ComboBox ItemsSource="{Binding GpuModeOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding ProfileDraft.GpuMode, Mode=TwoWay}"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.GpuClockLimit]}"/><TextBox Text="{Binding ProfileDraft.GpuMaxCoreClockMHzText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Strings[Section.GpuVoltageOffset]}"/><TextBox Text="{Binding ProfileDraft.GpuVoltageOffsetMvText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"/></StackPanel>
      </Grid>
      <CheckBox Margin="0,12,0,0" Content="{Binding Strings[Hint.GpuVendorApi]}" IsChecked="{Binding ProfileDraft.GpuAllowVendorApi, Mode=TwoWay}" IsEnabled="False"/>
      <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Hint.GpuStrategyPlanned]}"/>
     </StackPanel>
    </Border>
    <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.Notes]}"/><TextBox MinHeight="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding ProfileDraft.Notes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.Validation]}"/><TextBlock Margin="0,6,0,0" FontSize="12" Text="{Binding ValidationSummary}"/>
      <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ValidationIssues}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="8" Background="#FFFFF4E8" CornerRadius="10"><TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Margin="0,12,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.RevisionHistory]}"/>
      <ListBox Margin="0,8,0,0" Height="170" ItemsSource="{Binding ProfileHistory}" SelectedItem="{Binding SelectedProfileRevision, Mode=TwoWay}">
       <ListBox.ItemTemplate><DataTemplate DataType="{x:Type models:ProfileRevisionInfo}"><Border Margin="0,0,0,8" Padding="10" Background="#FFF7FAFB" BorderBrush="#FFE1E8EC" BorderThickness="1" CornerRadius="10"><StackPanel><TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding DisplayName}"/><TextBlock Margin="0,4,0,0" FontSize="11" Text="{Binding Profile.Notes}" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </StackPanel>
    </Grid>
   </StackPanel></Border>
  </Grid>
 </Grid>
</ScrollViewer>
</UserControl>
