<UserControl x:Class="PerformanceScheduler.App.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
    <Grid Margin="20"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <TabControl Style="{StaticResource SegmentedTabControlStyle}">
            <!-- 分段 1: 硬件拓扑与工况 -->
            <TabItem Header="{Binding Strings[Segment.HardwareTopology]}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部三列核心感知状态卡 -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 卡片 1: 前台应用感知 -->
                        <Border Grid.Column="0" Margin="0,0,14,0" Padding="16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" Background="#FFEAF2FF" CornerRadius="16" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="App" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.ForegroundTarget]}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TitleBrush}" Text="{Binding FocusedAppName}" />
                                    <TextBlock Margin="0,3,0,0" MaxHeight="30" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding FocusedAppDetails}" />
                                    <Border Margin="0,5,0,0" Padding="8,3" HorizontalAlignment="Left" Background="#FFE7F8EC" CornerRadius="8">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#FF149A48" Text="{Binding ClassificationSummary}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 卡片 2: 调度引擎运行态与控制 -->
                        <Border Grid.Column="1" Margin="0,0,14,0" Padding="16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.QuickActions]}" />
                                    <primitives:ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding IsMonitoringRunning, Mode=OneWay}" Command="{Binding ToggleMonitoringCommand}" IsEnabled="{Binding CanToggleMonitoring}" />
                                </DockPanel>
                                <Grid Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#FFEAF2FF" CornerRadius="18" HorizontalAlignment="Left">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="✓" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TitleBrush}" Text="{Binding MonitoringToggleButtonText}" />
                                        <TextBlock Margin="0,3,0,0" MaxHeight="36" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding MonitoringStatus}" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 卡片 3: 设备指纹与自愈基准 -->
                        <Border Grid.Column="2" Padding="16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold" Foreground="#FF277EA3" Text="{Binding Strings[Section.DeviceFingerprint]}" />
                                    <Button DockPanel.Dock="Right" Padding="8,4" FontSize="11" Margin="0" Content="{Binding Strings[Button.ScanNow]}" Command="{Binding RefreshCommand}" Background="#FF2E9AAE" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" MaxHeight="52" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TitleBrush}" ToolTip="{Binding DeviceFingerprintSummary}" Text="{Binding DeviceFingerprintSummary}" />
                                <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding LastRefreshTime}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 下半部分两列：硬件驱动就绪与系统存储 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左列：GPU 适配器与驱动能力 -->
                        <Border Grid.Column="0" Margin="0,0,14,0" Padding="18" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource PageEyebrowStyle}" Foreground="#FF4E65A8" Text="{Binding Strings[Section.GpuReadiness]}" />
                                    <Button DockPanel.Dock="Right" Padding="8,4" FontSize="11" Margin="0" Content="{Binding Strings[Button.RefreshCapabilities]}" Command="{Binding RefreshCapabilitiesCommand}" Background="#FF4E65A8" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" Margin="0,10,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" TextTrimming="CharacterEllipsis" Text="{Binding GpuAdapterSummary}" />
                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Border Margin="0,0,0,10" Padding="12" Background="#FFF5FAFF" BorderBrush="#FFDCE6F5" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="GPU 硬件特性与厂商 API" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding GpuCapabilitySummary}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" Background="#FFF6F8FD" BorderBrush="#FFE0E6F5" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="控频就绪评估" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding GpuControlReadinessSummary}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 右列：系统存储与运行数据 -->
                        <Border Grid.Column="1" Padding="18" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.StorageOverview]}" />
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <Border Margin="0,0,0,10" Padding="12" Background="#FFF9FCFD" BorderBrush="#FFE4EEF7" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="运行时状态存储" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StorageSummary}" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding StorageSummary}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" Background="#FFEAF2FF" BorderBrush="#FFD6E6FF" BorderThickness="1" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding MonitoringModeSummary}" />
                                            <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding MonitoringStatus}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.OpenRuntimeDirectory]}" Command="{Binding OpenRuntimeDirectoryCommand}" Background="#FF4E7080" />
                                    <Button Padding="10,6" FontSize="11" Content="{Binding Strings[Button.OpenLogsDirectory]}" Command="{Binding OpenLogsDirectoryCommand}" Background="#FF6A86B7" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 分段 2: 专属策略包 -->
            <TabItem Header="{Binding Strings[Segment.DeviceStrategyPacks]}">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部操作条 -->
                    <Border Grid.Row="0" Margin="0,0,0,14" Padding="14" Style="{StaticResource CardStyle}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.DeviceStrategies]}" />
                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Strings[Hint.ProfilePathLocalBody]}" />
                            </StackPanel>
                            <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.CreateDeviceStrategy]}" Command="{Binding CreateDeviceStrategyPackageCommand}" />
                                <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.ToggleDeviceStrategy]}" Command="{Binding ToggleDeviceStrategyPackageCommand}" />
                                <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.OpenDeviceStrategiesDirectory]}" Command="{Binding OpenDeviceStrategiesDirectoryCommand}" Background="#FF2E9AAE" />
                                <Button Padding="10,6" FontSize="11" Content="{Binding Strings[Button.RefreshCommunity]}" Command="{Binding RefreshCommunityCatalogCommand}" Background="#FF6178A6" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>

                    <!-- 下方两栏：策略包列表与策略明细 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：已安装机型策略包 -->
                        <Border Grid.Column="0" Margin="0,0,12,0" Padding="16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.LocalDeviceStrategies]}" />
                                <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding DeviceStrategyPackages}" SelectedItem="{Binding SelectedDeviceStrategyPackage, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:DeviceStrategyPackageListItemViewModel}">
                                            <Border Margin="0,0,0,8" Padding="12" Background="White" BorderBrush="#FFD6E8EF" BorderThickness="1" CornerRadius="12">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Name}" />
                                                        <Border DockPanel.Dock="Right" Padding="6,2" Background="#FFEAF2FF" CornerRadius="6">
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding EnabledText}" />
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Summary}" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource AccentBrush}" Text="{Binding Meta}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- 右侧：策略包包含的应用规则 -->
                        <Border Grid.Column="1" Padding="16" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.DeviceStrategyContents]}" />
                                <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding SelectedDeviceStrategyProfiles}" SelectedItem="{Binding SelectedDeviceStrategyProfile, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type viewModels:DeviceStrategyProfileItemViewModel}">
                                            <Border Margin="0,0,0,6" Padding="10" Background="White" BorderBrush="#FFE2E8EC" BorderThickness="1" CornerRadius="10">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TitleBrush}" Text="{Binding Name}" />
                                                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}" Text="{Binding Meta}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                                    <Button Margin="0,0,8,0" Padding="10,6" FontSize="11" Content="{Binding Strings[Button.AddProfileToDeviceStrategy]}" Command="{Binding AddProfileToDeviceStrategyCommand}" Background="#FF1F7A5C" />
                                    <Button Padding="10,6" FontSize="11" Content="{Binding Strings[Button.RemoveProfileFromDeviceStrategy]}" Command="{Binding RemoveProfileFromDeviceStrategyCommand}" Background="#FF8A3B49" />
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
