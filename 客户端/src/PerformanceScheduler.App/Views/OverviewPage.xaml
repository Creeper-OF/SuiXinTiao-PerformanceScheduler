<UserControl x:Class="PerformanceScheduler.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
    <Grid Margin="28,20,28,24"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面顶栏：标题与状态徽章 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Nav.OverviewTitle]}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="实时前台应用感知 · 硬件负载与调度状态" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Padding="14,6" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFE8F7EE" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="False">
                                <Setter Property="Background" Value="#FFFFF4E5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF1FB357" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="False">
                                        <Setter Property="Fill" Value="#FFE09A24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF17823F" />
                                <Setter Property="Text" Value="调度运行中" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="False">
                                        <Setter Property="Foreground" Value="#FFB3730E" />
                                        <Setter Property="Text" Value="调度已暂停" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- 卡片 1: 当前应用与快速调度控制 -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="当前应用：" />
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding FocusedAppName}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource SidebarMutedBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}命中：{0} · 供电 {1} · 规则 {2}">
                                <Binding Path="MatchedProfileName" TargetNullValue="未匹配" />
                                <Binding Path="ActivePowerPlanName" TargetNullValue="默认" />
                                <Binding Path="ProfileReason" TargetNullValue="自动探测" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <Button DockPanel.Dock="Right" Padding="18,10" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#FFEAF2FF" Foreground="{StaticResource AccentBrush}" BorderThickness="0"
                        Command="{Binding ToggleMonitoringCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="暂停调度" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="False">
                                    <Setter Property="Content" Value="恢复调度" />
                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </DockPanel>
        </Border>

        <!-- 4 个核心指标网格 (2x2) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 指标 1: CPU 利用率 -->
            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="24,18" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="CPU 利用率" />
                    <TextBlock Margin="0,8,0,0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding FocusedAppCpuUsagePercent, StringFormat={}{0:F0}%}" />
                </StackPanel>
            </Border>

            <!-- 指标 2: GPU 利用率 -->
            <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="24,18" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="GPU 利用率" />
                    <TextBlock Margin="0,8,0,0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding FocusedAppGpuUsagePercent, StringFormat={}{0:F0}%, TargetNullValue='--'}" />
                </StackPanel>
            </Border>

            <!-- 指标 3: 实时 FPS -->
            <Border Grid.Row="1" Grid.Column="0" Margin="0,8,8,0" Padding="24,18" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="实时 FPS" />
                    <TextBlock Margin="0,8,0,0" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding FocusedAppFps, StringFormat={}{0:F0}, TargetNullValue='--'}" />
                </StackPanel>
            </Border>

            <!-- 指标 4: 供电模式 -->
            <Border Grid.Row="1" Grid.Column="1" Margin="8,8,0,0" Padding="24,18" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SidebarMutedBrush}" Text="供电模式" />
                    <TextBlock Margin="0,8,0,0" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding CurrentPowerSourceLabel, TargetNullValue='AC 插电'}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 卡片 6: 最新事件卡片 (通栏) -->
        <Border Grid.Row="3" Padding="20,16" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="最新事件" />
                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource SidebarMutedBrush}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} 前台应用切换 → {1} → {2}">
                            <Binding Path="LastRefreshTime" />
                            <Binding Path="FocusedAppName" />
                            <Binding Path="LastSummary" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
