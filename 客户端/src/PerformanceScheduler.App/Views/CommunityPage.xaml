<UserControl x:Class="PerformanceScheduler.App.Views.CommunityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
    <Grid Margin="28,20,28,24"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Nav.CommunityTitle]}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="社区机型策略包与精选方案 · 云端同步与验证" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Padding="16,8" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Content="刷新社区资源" Command="{Binding RefreshCommunityCatalogCommand}" />
        </DockPanel>

        <!-- 筛选与搜索工具条 -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="16,12" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0,0,12,0" Height="36" VerticalContentAlignment="Center"
                         Text="{Binding CommunitySearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="1" Margin="0,0,12,0" Height="36" VerticalAlignment="Center"
                          ItemsSource="{Binding CommunityPowerFilterOptions}" DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedCommunityPowerFilter, Mode=TwoWay}" />
                <ComboBox Grid.Column="2" Height="36" VerticalAlignment="Center"
                          ItemsSource="{Binding CommunityClassificationFilterOptions}" DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedCommunityClassificationFilter, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- 社区方案列表卡片 -->
        <Border Grid.Row="2" Padding="20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Margin="0,0,0,12" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="热门社区机型策略包" />
                <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding CommunityDeviceStrategies}"
                         SelectedItem="{Binding SelectedCommunityDeviceStrategy, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:CommunityDeviceStrategyListItemViewModel}">
                            <Border Margin="0,0,0,10" Padding="18,14" Background="#FFF9FCFE" BorderBrush="#FFE5EDF5" BorderThickness="1" CornerRadius="12">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Name}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding Summary}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}" Text="{Binding Meta}" />
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right" Padding="14,8" VerticalAlignment="Center"
                                            Content="导入并匹配" Command="{Binding DataContext.ImportCommunityDeviceStrategyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
