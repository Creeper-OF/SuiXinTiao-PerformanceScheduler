<UserControl x:Class="PerformanceScheduler.App.Views.AppProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
    <Grid Margin="28,20,28,24"
          ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
          ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock FontSize="26" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Nav.AppProfilesTitle]}" />
            <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SidebarMutedBrush}" Text="AC 插电与 DC 离电独立配置 · 绝不跨供电状态意外继承" />
        </StackPanel>

        <!-- 顶部卡片: 应用识别与匹配规则 -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="24,20" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="应用：" />
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding FocusedAppName, TargetNullValue='Game.exe'}" />
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource SidebarMutedBrush}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}匹配方式：{0} | 当前前台状态：{1}">
                                <Binding Path="ClassificationSummary" TargetNullValue="进程路径 + 进程名" />
                                <Binding Path="FocusedAppDetails" TargetNullValue="活跃" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
                <Button DockPanel.Dock="Right" Padding="18,10" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#FFEAF2FF" Foreground="{StaticResource AccentBrush}" BorderThickness="0"
                        Content="编辑识别" Command="{Binding RefreshCommand}" />
            </DockPanel>
        </Border>

        <!-- 中部两张并排卡片: AC 插电策略 vs DC 离电策略 (独立双轨) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左卡片: AC 插电策略 -->
            <Border Grid.Column="0" Margin="0,0,8,0" Padding="24,22" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="AC 插电策略" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource SidebarMutedBrush}" Text="{Binding MatchedProfileName, TargetNullValue='游戏性能模式 · 专属配置'}" />
                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,6" HorizontalAlignment="Left" Background="#FFE8F7EE" CornerRadius="10">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FF17823F" Text="已配置" />
                    </Border>
                    <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Cursor="Hand" Text="编辑 / 设为跟随全局" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右卡片: DC 离电策略 -->
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="24,22" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="DC 离电策略" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource SidebarMutedBrush}" Text="不使用 AC 专属配置" />
                    <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,6" HorizontalAlignment="Left" Background="#FFEAF2FF" CornerRadius="10">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="跟随全局 DC" />
                    </Border>
                    <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal">
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Cursor="Hand" Text="编辑 / 设为跟随全局" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部当前优先级规则说明卡片 -->
        <Border Grid.Row="3" Padding="20,16" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="1" CornerRadius="16">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="当前优先级规则" />
                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource SidebarMutedBrush}"
                           Text="根据供电状态，只检查对应 AC 或 DC 的应用专属策略；若缺失，整套回退到同状态全局策略。" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
