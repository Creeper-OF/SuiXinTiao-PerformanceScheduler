<UserControl x:Class="PerformanceScheduler.App.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
             xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid Margin="28"
        ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
        ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <UniformGrid Columns="4" Margin="0,0,0,20">
    <Border Margin="0,0,14,0" Style="{StaticResource CardStyle}" Background="#FFF8FBFD">
     <StackPanel>
      <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.RuntimeStatus]}"/>
      <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" TextTrimming="CharacterEllipsis" Text="{Binding MonitoringModeSummary}"/>
      <TextBlock Margin="0,7,0,0" MaxHeight="38" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding MonitoringStatus}"/>
      <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding LastRefreshTime}"/>
     </StackPanel>
    </Border>
    <Border Margin="0,0,14,0" Style="{StaticResource CardStyle}" Background="#FFF7FAFB">
     <StackPanel>
      <TextBlock Style="{StaticResource PageEyebrowStyle}" Text="{Binding Strings[Section.Storage]}"/>
      <TextBlock Margin="0,8,0,0" MaxHeight="62" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TitleBrush}" ToolTip="{Binding StorageSummary}" Text="{Binding StorageSummary}"/>
     </StackPanel>
    </Border>
    <Border Margin="0,0,14,0" Style="{StaticResource CardStyle}" Background="#FFF6F8FD">
     <StackPanel>
      <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF4E65A8" Text="{Binding Strings[Section.GpuReadiness]}"/>
      <TextBlock Margin="0,8,0,0" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" TextTrimming="CharacterEllipsis" Text="{Binding GpuAdapterSummary}"/>
      <TextBlock Margin="0,8,0,0" MaxHeight="36" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding GpuCapabilitySummary}"/>
      <TextBlock Margin="0,5,0,0" MaxHeight="36" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding GpuControlReadinessSummary}"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource CardStyle}" Background="#FFF3FAFE">
     <StackPanel>
      <TextBlock Style="{StaticResource PageEyebrowStyle}" Foreground="#FF277EA3" Text="{Binding Strings[Section.DeviceFingerprint]}"/>
      <TextBlock Margin="0,8,0,0" MaxHeight="62" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TitleBrush}" ToolTip="{Binding DeviceFingerprintSummary}" Text="{Binding DeviceFingerprintSummary}"/>
     </StackPanel>
    </Border>
   </UniformGrid>

   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Margin="0,0,9,0" Style="{StaticResource CardStyle}">
     <StackPanel>
      <Border Margin="0,0,0,14" Padding="14" Background="#FFF5FAF8" BorderBrush="#FFCCE8E0" BorderThickness="1" CornerRadius="14">
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock FontSize="13" FontWeight="Bold" Foreground="#FF1F6F5E" Text="{Binding Strings[Section.HardwareSelfTest]}"/>
          <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#FF5A736E" Text="{Binding SelfTestStatusSummary}"/>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Padding="9,5" Margin="0,0,6,0" Content="{Binding Strings[Button.RunFullSelfTest]}" Command="{Binding RunFullSelfTestCommand}" Background="#FF228670"/>
          <Button Padding="9,5" Margin="0,0,6,0" Content="{Binding Strings[Button.TestGpuClocks]}" Command="{Binding RunGpuSelfTestCommand}" Background="#FF3D7098"/>
          <Button Padding="9,5" Content="{Binding Strings[Button.TestEmergencyGate]}" Command="{Binding RunPowerEmergencySelfTestCommand}" Background="#FF8E5C38"/>
         </StackPanel>
        </Grid>
        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding SelfTestResultLines}">
         <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="#FF203C35" Text="{Binding}"/></DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.CapabilityDetector]}"/>
       <Button Grid.Column="1" Padding="10,5" Content="{Binding Strings[Button.RefreshCapabilities]}" Command="{Binding RefreshCapabilitiesCommand}" Background="#FF2E9AAE"/>
      </Grid>
      <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding CapabilityLines}">
       <ItemsControl.ItemTemplate>
        <DataTemplate><Border Margin="0,0,0,10" Padding="12" Background="#FFF5F8FA" CornerRadius="12"><TextBlock FontSize="13" TextWrapping="Wrap" Text="{Binding}"/></Border></DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Margin="0,8,0,0" Padding="12" Background="#FFF7FAFF" BorderBrush="#FFD5E7FF" BorderThickness="1" CornerRadius="12">
       <StackPanel>
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.TelemetryCapabilities]}"/>
        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding TelemetryCapabilityLines}">
         <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Text="{Binding}"/></DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>
      <Border Margin="0,8,0,0" Padding="12" Background="#FFEFF7FF" BorderBrush="#FFD5E7FF" BorderThickness="1" CornerRadius="12">
       <StackPanel>
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.ReadOnlyTelemetry]}"/>
        <TextBlock Margin="0,7,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding TelemetryObservationSummary}"/>
        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Content="{Binding Strings[Button.CaptureTelemetryObservation]}" Command="{Binding CaptureTelemetryObservationCommand}" Background="#FF2E9AAE"/>
        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding TelemetryObservationLines}">
         <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Text="{Binding}"/></DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Height="1" Margin="0,12,0,10" Background="#FFD5E7EE"/>
        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.TelemetryHistory]}"/>
        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding TelemetryHistoryLines}">
         <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Text="{Binding}"/></DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Margin="0,12,0,0" Padding="12" Background="#FFF7FAFF" BorderBrush="#FFD5E7FF" BorderThickness="1" CornerRadius="12">
         <StackPanel>
          <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.TelemetryTrendChart]}"/>
          <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#FF607180" TextWrapping="Wrap" Text="{Binding Strings[Status.TelemetryTrendEmpty]}">
           <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
             <Setter Property="Visibility" Value="Collapsed"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding HasTelemetryTrendItems}" Value="False">
               <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
          <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding TelemetryTrendItems}">
           <ItemsControl.ItemTemplate>
            <DataTemplate>
             <Grid Margin="0,0,0,10">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid>
               <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
               <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding MetricName}"/>
               <TextBlock Grid.Column="1" FontSize="10" Foreground="#FF607180" Text="{Binding ProviderName}"/>
              </Grid>
              <ProgressBar Grid.Row="1" Margin="0,5,0,3" Height="7" Minimum="0" Maximum="100" Value="{Binding LatestRatio}" Foreground="{Binding DirectionColor}" Background="#FFE6EDF3" BorderThickness="0"/>
              <Grid Grid.Row="2">
               <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
               <TextBlock FontSize="10" Foreground="#FF607180" TextWrapping="Wrap" Text="{Binding Summary}"/>
               <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{Binding DirectionColor}" Text="{Binding Direction}"/>
              </Grid>
             </Grid>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </Border>
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>
    <Border Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource CardStyle}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <StackPanel Orientation="Horizontal">
         <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.RecentLogs]}"/>
         <TextBlock Margin="12,0,0,0" FontSize="12" Text="{Binding LastRefreshTime}"/>
        </StackPanel>
        <TextBlock Margin="0,6,12,0" FontSize="11" Foreground="#FF607180" TextTrimming="CharacterEllipsis" ToolTip="{Binding DiagnosticPackageStatus}" Text="{Binding DiagnosticPackageStatus}"/>
       </StackPanel>
       <Button Grid.Column="1" Content="{Binding Strings[Button.ExportDiagnosticPackage]}" Command="{Binding ExportDiagnosticPackageCommand}" Background="#FF2E9AAE"/>
      </Grid>
      <ListBox Grid.Row="1" Margin="0,16,0,0" MaxHeight="300" ItemsSource="{Binding RecentLogs}">
       <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type viewModels:LogEntryItemViewModel}">
         <Border Margin="0,0,0,10" Padding="12" Background="#FFF8FAFB" BorderBrush="#FFE3E8EC" BorderThickness="1" CornerRadius="12">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="74"/><ColumnDefinition Width="74"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock FontFamily="Consolas" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"/>
           <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Audience}"/>
           <TextBlock Grid.Column="2" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Level}"/>
           <TextBlock Grid.Column="3" TextWrapping="Wrap" Text="{Binding Message}" ToolTip="{Binding TechnicalMessage}"/>
          </Grid>
         </Border>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </Border>
   </Grid>

   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Margin="0,0,9,0" Style="{StaticResource CardStyle}" Background="#FFF8FBFF">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.RecentActions]}"/>
        <TextBlock Margin="0,8,0,0" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding ActionAuditSummary}"/>
        <TextBlock Margin="0,5,0,0" MaxWidth="430" FontSize="11" Foreground="#FF607180" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedRuntimeHistoryDetail}" Text="{Binding SelectedRuntimeHistoryDetail}"/>
       </StackPanel>
       <ComboBox Grid.Column="1"
                 Margin="14,0,0,0"
                 VerticalAlignment="Center"
                 ItemsSource="{Binding RuntimeHistoryItems}"
                 SelectedItem="{Binding SelectedRuntimeHistory, Mode=TwoWay}"
                 DisplayMemberPath="DisplayName"
                 IsTextSearchEnabled="False"/>
      </Grid>
      <ListBox Grid.Row="1" Margin="0,14,0,0" MaxHeight="260" ScrollViewer.CanContentScroll="False" ui:SmoothScrollBehavior.IsEnabled="{Binding UiMotionEnabled}" ItemsSource="{Binding ActionAuditItems}">
       <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type viewModels:SchedulerActionItemViewModel}">
         <Border Margin="0,0,0,10" Padding="12" Background="#FFF8FAFB" BorderBrush="#FFE3E8EC" BorderThickness="1" CornerRadius="12">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Kind}"/>
           <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Status}"/>
           <TextBlock Grid.Column="2" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" Text="{Binding Target}"/>
           <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,7,0,0" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding ValueChange}" Text="{Binding ValueChange}"/>
           <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,7,0,0">
            <TextBlock FontSize="12" TextWrapping="Wrap" ToolTip="{Binding TechnicalMessage}" Text="{Binding Message}"/>
            <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Suggestion}"/>
            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#FF607180" Text="{Binding Recovery}"/>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate>
       </ListBox.ItemTemplate>
      </ListBox>
     </Grid>
    </Border>
   <Border Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource CardStyle}" Background="#FFFCFDFC">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.StatusCenter]}"/>
       <TextBlock Margin="0,8,0,0" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding StatusCenterSummary}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="{Binding Strings[Button.ClearStatusCenter]}" Command="{Binding ClearStatusCenterCommand}" Background="#FF4E7080"/>
     </Grid>
     <ListBox Grid.Row="1" Margin="0,14,0,0" MaxHeight="260" ScrollViewer.CanContentScroll="False" ui:SmoothScrollBehavior.IsEnabled="{Binding UiMotionEnabled}" ItemsSource="{Binding StatusCenterItems}">
      <ListBox.ItemTemplate>
       <DataTemplate DataType="{x:Type viewModels:StatusCenterItemViewModel}">
        <Border Margin="0,0,0,10" Padding="12" Background="#FFF8FAFB" BorderBrush="#FFE3E8EC" BorderThickness="1" CornerRadius="12">
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="110"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock FontFamily="Consolas" Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm:ss}}"/>
          <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Source}"/>
          <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding Level}"/>
          <TextBlock Grid.Column="3" TextWrapping="Wrap" Text="{Binding Message}"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   </Grid>
  </Grid>
 </ScrollViewer>
</UserControl>
