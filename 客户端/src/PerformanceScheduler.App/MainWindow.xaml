<Window x:Class="PerformanceScheduler.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui"
        xmlns:viewModels="clr-namespace:PerformanceScheduler.App.ViewModels"
        xmlns:views="clr-namespace:PerformanceScheduler.App.Views"
        mc:Ignorable="d"
        Title="{Binding Strings[App.Title]}" Width="1360" Height="860" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="#FFF7F9FC">
        <!-- 背景图片与蒙版 -->
        <Image Source="{Binding AppearanceBackgroundImagePath, Converter={StaticResource ImagePathToBitmapConverter}}"
               Stretch="UniformToFill" Opacity="{Binding AppearanceBackgroundImageOpacity}"
               Visibility="{Binding AppearanceBackgroundImageVisibility}" IsHitTestVisible="False" />
        <Border Background="{Binding AppearanceWindowOverlayBrush}" BorderBrush="#FFE3EAF4" BorderThickness="1">
            <TabControl Background="Transparent"
                        BorderThickness="0"
                        TabStripPlacement="Left"
                        SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                        ui:PageTransitionBehavior.IsEnabled="{Binding UiMotionEnabled}"
                        ui:PageTransitionBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
                <TabControl.Resources>
                    <!-- 极简侧边栏导航按钮样式 -->
                    <Style x:Key="SidebarTabItemStyle" TargetType="TabItem">
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Padding" Value="16,11" />
                        <Setter Property="Foreground" Value="#FF4F5E71" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="ItemBorder" Margin="{TemplateBinding Margin}" Padding="{TemplateBinding Padding}"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="12">
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FFF0F4FA" />
                                            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#FFEBF2FF" />
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="TabItem" BasedOn="{StaticResource SidebarTabItemStyle}" />

                    <!-- 窗口控制按钮 -->
                    <Style x:Key="WindowControlButtonStyle" TargetType="Button">
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Margin" Value="4,0,0,0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="#FFEAF2FF" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="WindowButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                                   Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="WindowButtonSurface" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="WindowButtonSurface" Property="Background" Value="#FF155EE0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
                        <Setter Property="Background" Value="#FFFFEDF0" />
                        <Setter Property="Foreground" Value="#FFD64045" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFD64045" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- 语言切换按钮 -->
                    <Style x:Key="LanguageSwitchButtonStyle" TargetType="Button">
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="Background" Value="#FFFFFFFF" />
                        <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="LanguageButtonSurface" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="🌐 " />
                                            <TextBlock FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding DataContext.SelectedLanguage.DisplayName, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="LanguageButtonSurface" Property="Background" Value="#FFF6FAFF" />
                                            <Setter TargetName="LanguageButtonSurface" Property="BorderBrush" Value="#FFBFD8FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧侧边栏 (极简设计原型风格) -->
                            <Border Grid.Column="0" Padding="18,16" Background="#FFFFFFFF" BorderBrush="#FFE5EAF2" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 顶部品牌 Logo -->
                                    <StackPanel Grid.Row="0" Margin="4,6,0,20">
                                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding DataContext.Strings[App.Title], RelativeSource={RelativeSource TemplatedParent}}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="PerformanceScheduler" />
                                    </StackPanel>

                                    <!-- 8 个一级导航项列表 -->
                                    <TabPanel Grid.Row="1" IsItemsHost="True" Background="Transparent" />

                                    <!-- 底部小工具栏: 语言切换与版权 -->
                                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource LanguageSwitchButtonStyle}" Click="LanguageSwitchButton_Click" />
                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource SidebarMutedBrush}" Text="v1.0" />
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- 右侧主内容区域 -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 窗口顶栏: 仅用于窗口拖拽与控制按钮 -->
                                <Border Grid.Row="0" Padding="16,0,12,0" Background="Transparent">
                                    <DockPanel VerticalAlignment="Center">
                                        <!-- 右侧窗口按钮与紧急回滚 -->
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                            <Button Margin="0,0,10,0" Height="28" Padding="12,0" Background="#FFFFF2F4" Foreground="#FFD64045" BorderBrush="#FFFFD0D6" BorderThickness="1"
                                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding DataContext.Strings[Hint.RollbackCard], RelativeSource={RelativeSource TemplatedParent}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" Text="↶ " />
                                                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" Text="一键紧急回滚" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <Button Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeWindow_Click" Content="━" />
                                            <Button Style="{StaticResource WindowControlButtonStyle}" Click="ToggleMaximizeWindow_Click" Content="□" />
                                            <Button Style="{StaticResource CloseWindowButtonStyle}" Click="CloseWindow_Click" Content="×" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- 页面实际内容 Host -->
                                <Border Grid.Row="1" Background="Transparent">
                                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- 8 个一级导航页面对应项 -->
                <!-- 0: 总览 -->
                <TabItem Header="{Binding Strings[Nav.OverviewTitle]}">
                    <views:OverviewPage />
                </TabItem>

                <!-- 1: 应用策略 -->
                <TabItem Header="{Binding Strings[Nav.AppProfilesTitle]}">
                    <views:AppProfilesPage />
                </TabItem>

                <!-- 2: 全局策略 -->
                <TabItem Header="{Binding Strings[Nav.GlobalPoliciesTitle]}">
                    <views:GlobalPoliciesPage />
                </TabItem>

                <!-- 3: 性能监控 -->
                <TabItem Header="{Binding Strings[Nav.TelemetryTitle]}">
                    <views:PerformancePage />
                </TabItem>

                <!-- 4: 方案库 -->
                <TabItem Header="{Binding Strings[Nav.LibraryTitle]}">
                    <views:StrategyLibraryPage />
                </TabItem>

                <!-- 5: 社区 -->
                <TabItem Header="{Binding Strings[Nav.CommunityTitle]}">
                    <views:CommunityPage />
                </TabItem>

                <!-- 6: 安全与恢复 -->
                <TabItem Header="{Binding Strings[Nav.SafetyTitle]}">
                    <views:SafetyPage />
                </TabItem>

                <!-- 7: 设置 -->
                <TabItem Header="{Binding Strings[Nav.SettingsTitle]}">
                    <views:SettingsPage />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
