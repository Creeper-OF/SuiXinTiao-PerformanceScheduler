<UserControl x:Class="PerformanceScheduler.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:ui="clr-namespace:PerformanceScheduler.App.Ui">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <Grid Margin="28"
        ui:StaggeredRevealBehavior.IsEnabled="{Binding UiStaggeredRevealEnabled}"
        ui:StaggeredRevealBehavior.DurationMilliseconds="{Binding UiMotionDurationMilliseconds}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Style="{StaticResource CardStyle}" Background="#FFF9FCFD">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.Settings]}"/>
      <TextBlock Margin="0,10,0,0" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Section.MonitoringInterval]}"/>
      <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.MonitoringInterval]}"/>
     </StackPanel>
     <ComboBox Grid.Column="1" ItemsSource="{Binding MonitoringIntervalOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding MonitoringIntervalSeconds, Mode=TwoWay}"/>
    </Grid>
   </Border>

   <Border Grid.Row="1" Style="{StaticResource CardStyle}" Background="#FFF8FAFF">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,18,0">
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.UiMotionSettings]}"/>
      <DockPanel Margin="0,10,0,0">
       <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UiMotionEnabled, Mode=TwoWay}"/>
       <StackPanel VerticalAlignment="Center">
        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.UiMotionEnabledTitle]}"/>
        <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.UiMotionEnabled]}"/>
       </StackPanel>
      </DockPanel>
      <Grid Margin="0,12,0,0" IsEnabled="{Binding UiMotionEnabled}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.UiMotionDuration]}"/>
       <TextBlock Grid.Column="1" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="{Binding UiMotionDurationMilliseconds, StringFormat={}{0:F0} ms}"/>
       <Slider Grid.ColumnSpan="2" Margin="0,24,0,0" Minimum="120" Maximum="800" TickFrequency="20" IsSnapToTickEnabled="True" Value="{Binding UiMotionDurationMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=120}"/>
      </Grid>
      <DockPanel Margin="0,10,0,0" IsEnabled="{Binding UiMotionEnabled}">
       <primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding UiMotionStaggerEnabled, Mode=TwoWay}"/>
       <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.UiMotionStagger]}"/>
      </DockPanel>
     </StackPanel>
     <Border Grid.Column="1" Padding="14" Background="#FFFFFFFF" BorderBrush="#FFE1EAF7" BorderThickness="1" CornerRadius="16">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
       <primitives:ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LanguageTransitionAnimationEnabled, Mode=TwoWay}"/>
       <StackPanel Grid.Column="1" Margin="8,0,12,0">
        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.LanguageAnimationSettings]}"/>
        <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding Strings[Hint.LanguageTransitionAnimationEnabled]}"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" Text="{Binding Strings[Hint.LanguageTransitionDurationSeconds]}"/>
        <TextBox Text="{Binding LanguageTransitionDurationSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=150, ValidatesOnExceptions=True}"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
   </Border>

   <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,20">
    <Border Margin="0,0,14,0" Style="{StaticResource CardStyle}" Background="#FFF7FAFB">
     <StackPanel>
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.SafetySettings]}"/>
      <DockPanel Margin="0,12,0,0"><primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding PauseSchedulingAfterUnsafeExit, Mode=TwoWay}"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[Hint.PauseSchedulingAfterUnsafeExit]}"/></DockPanel>
      <DockPanel Margin="0,10,0,0"><primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoRollbackOnUnsafeExit, Mode=TwoWay}"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[Hint.AutoRollbackOnUnsafeExit]}"/></DockPanel>
      <DockPanel Margin="0,10,0,0"><primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding DisableProfileAfterRepeatedUnsafeRuns, Mode=TwoWay}"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[Hint.DisableProfileAfterRepeatedUnsafeRuns]}"/></DockPanel>
      <StackPanel Margin="0,14,0,0" HorizontalAlignment="Left">
       <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" Text="{Binding Strings[Hint.UnsafeRunThreshold]}"/>
       <TextBox Width="120" Text="{Binding UnsafeRunThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
      </StackPanel>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource CardStyle}" Background="#FFF6FBFD">
     <StackPanel>
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.StartupSettings]}"/>
      <DockPanel Margin="0,12,0,0"><primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[Hint.LaunchAtStartup]}"/></DockPanel>
      <DockPanel Margin="0,10,0,0"><primitives:ToggleButton DockPanel.Dock="Left" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AutoStartMonitoringOnLaunch, Mode=TwoWay}"/><TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[Hint.AutoStartMonitoringOnLaunch]}"/></DockPanel>
     </StackPanel>
    </Border>
   </UniformGrid>

   <Border Grid.Row="3" Style="{StaticResource CardStyle}" Background="#FFF5FAFF">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,18,0">
      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.PresentMonIntegration]}"/>
      <TextBlock Margin="0,8,0,0" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TitleBrush}" Text="{Binding PresentMonIntegrationStatus}"/>
      <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="#FF607180" Text="{Binding Strings[Hint.PresentMonIntegration]}"/>
      <Border Margin="0,10,0,0" Padding="10,7" Background="#FFFFFFFF" BorderBrush="#FFDDE9F3" BorderThickness="1" CornerRadius="10">
       <TextBlock FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding PresentMonExecutablePathDisplay}" Text="{Binding PresentMonExecutablePathDisplay}"/>
      </Border>
     </StackPanel>
     <WrapPanel Grid.Column="1" VerticalAlignment="Center">
      <Button Content="{Binding Strings[Button.ChoosePresentMonExecutable]}" Command="{Binding ChoosePresentMonExecutableCommand}" Background="#FF2E9AAE"/>
      <Button Content="{Binding Strings[Button.ClearPresentMonExecutable]}" Command="{Binding ClearPresentMonExecutableCommand}" Background="#FF6A86B7"/>
     </WrapPanel>
    </Grid>
   </Border>

   <Border Grid.Row="4" Style="{StaticResource CardStyle}" Background="#FFF8FBFD">
    <StackPanel>
     <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding Strings[Section.DataLocations]}"/>
     <TextBlock Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" FontFamily="Consolas" Text="{Binding DataLocationSummary}"/>
     <WrapPanel Margin="0,14,0,0">
      <Button Content="{Binding Strings[Button.OpenProfilesDirectory]}" Command="{Binding OpenProfilesDirectoryCommand}" Background="#FF1E8FA3"/>
      <Button Content="{Binding Strings[Button.OpenDeviceStrategiesDirectory]}" Command="{Binding OpenDeviceStrategiesDirectoryCommand}" Background="#FF2E9AAE"/>
      <Button Content="{Binding Strings[Button.OpenRuntimeDirectory]}" Command="{Binding OpenRuntimeDirectoryCommand}" Background="#FF4E7080"/>
      <Button Content="{Binding Strings[Button.OpenLogsDirectory]}" Command="{Binding OpenLogsDirectoryCommand}" Background="#FF6A86B7"/>
      <Button Content="{Binding Strings[Button.OpenApplicationDirectory]}" Command="{Binding OpenApplicationDirectoryCommand}" Background="#FF9B6A18"/>
     </WrapPanel>
    </StackPanel>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>
